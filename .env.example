# Copy this file to .env.local and fill in real values.
# Where to find them is explained step-by-step in SETUP_GUIDE.md

# From Supabase: Project Settings -> API -> Project URL
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# From Supabase: Project Settings -> API -> service_role key (SECRET - never share)
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# The password you will type to open the /admin control room
ADMIN_PASSWORD=choose-a-strong-password

# The public address of the site (your Vercel URL or custom domain)
NEXT_PUBLIC_BASE_URL=https://vote.kenbharti.org
